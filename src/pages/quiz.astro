---
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { Font } from "astro:assets";
import "../styles/quiz.css";
import Quiz from "../quiz/Quiz.jsx";

/* Phosphor icons, self-hosted. Rather than loading the whole icon font, this
   scans the quiz's source for every `ph-<weight> ph-<name>` it mentions,
   reads just those SVGs from @phosphor-icons/core at build time, and inlines
   them as CSS masks. To use another weight, change "ph-light" to thin /
   regular / bold / fill / duotone. Browse the set at https://phosphoricons.com. */
const require = createRequire(import.meta.url);
const sources = import.meta.glob("../quiz/*.{js,jsx}", { query: "?raw", import: "default", eager: true });
const iconRefs = new Set(
  Object.values(sources).flatMap((source) =>
    [...source.matchAll(/\bph-(thin|light|regular|bold|fill|duotone)\s+ph-([a-z0-9-]+)/g)].map(
      (m) => `${m[1]}/${m[2]}`,
    ),
  ),
);
const iconCSS = [...iconRefs]
  .map((ref) => {
    const [weight, name] = ref.split("/");
    const file = weight === "regular" ? `${name}.svg` : `${name}-${weight}.svg`;
    const svg = readFileSync(require.resolve(`@phosphor-icons/core/assets/${weight}/${file}`), "utf8");
    const uri = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
    return `.ph-${weight}.ph-${name}::before{-webkit-mask-image:${uri};mask-image:${uri}}`;
  })
  .join("\n");

const title = "Ways to Pace";
const description =
  "A walk through the branching points that separate the camps arguing about how fast to build frontier AI.";
const canonicalURL = new URL(Astro.url.pathname, Astro.url);
const socialImageURL = new URL("/card.png", Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#042301" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pacing the Frontier, An Agenda" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1604" />
    <meta property="og:image:height" content="842" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Illustration of control surfaces for pacing AI development" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Illustration of control surfaces for pacing AI development" />

    <style is:global set:html={iconCSS}></style>

    <Font cssVariable="--font-satoshi" preload />
    <Font cssVariable="--font-body-serif" preload />
    <Font cssVariable="--font-plex-mono" />
  </head>

  <body class="font-serif text-(length:--prose-size) leading-[1.6] md:pl-70">
    <!-- The essay's sidebar (src/pages/index.astro): same width, padding
         and type, with the quiz's title and its opening paragraph in place
         of the table of contents. Fixed down the left from md; a block
         across the top below it, where the title runs on one line to
         leave room for the screen beneath. -->
    <aside class="select-none bg-sidebar text-background font-sans p-7 pb-6 md:pb-8 md:fixed md:inset-y-0 md:left-0 md:w-70 md:overflow-auto">
      <h1 class="gap-2 font-light grid text-5xl">
        <span>Ways</span>
        <span class="md:-ml-0.5">to</span>
        <span>Pace</span>
      </h1>
      <a class="inline-block mt-6 text-(--color-pace-how-bg) hover:text-(--color-why-pace-bg)" href="/">
        ← Back to paper
      </a>
      <div class="mt-7 grid gap-6 antialiased">
        <p>
          Experts who mostly agree that unrestricted AI progress poses significant risks to human societies still
          disagree on major branching points of the pacing debate.
        </p>
        <p>
          We created this interactive tool as an invitation for you to consider your position on these branching points
          and to give you an opportunity to compare others' views with your own.
        </p>
      </div>
    </aside>

    <!-- client:only, not client:load: the option order is shuffled per
         visit, so a server render would never match the client's. -->
    <main
      tabindex="0"
      class="flex w-full max-w-[860px] mx-auto flex-col pt-16 pb-7 px-(--x-padding) min-h-dvh md:min-h-0"
    >
      <Quiz client:only="preact" />
    </main>
  </body>
</html>
