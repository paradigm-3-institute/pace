---
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { Font } from "astro:assets";
import "../styles/quiz.css";
import Quiz from "../quiz/Quiz.jsx";

/* Phosphor icons, self-hosted. Rather than loading the whole icon font, this
   scans the quiz's source for every `ph-<weight> ph-<name>` it mentions,
   reads just those SVGs from @phosphor-icons/core at build time, and inlines
   them as CSS masks. To use another weight, change "ph-light" to thin /
   regular / bold / fill / duotone. Browse the set at https://phosphoricons.com. */
const require = createRequire(import.meta.url);
const sources = import.meta.glob("../quiz/*.{js,jsx}", { query: "?raw", import: "default", eager: true });
const iconRefs = new Set(
  Object.values(sources).flatMap((source) =>
    [...source.matchAll(/\bph-(thin|light|regular|bold|fill|duotone)\s+ph-([a-z0-9-]+)/g)].map(
      (m) => `${m[1]}/${m[2]}`,
    ),
  ),
);
const iconCSS = [...iconRefs]
  .map((ref) => {
    const [weight, name] = ref.split("/");
    const file = weight === "regular" ? `${name}.svg` : `${name}-${weight}.svg`;
    const svg = readFileSync(require.resolve(`@phosphor-icons/core/assets/${weight}/${file}`), "utf8");
    const uri = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
    return `.ph-${weight}.ph-${name}::before{-webkit-mask-image:${uri};mask-image:${uri}}`;
  })
  .join("\n");

const title = "Choose Your Pace";
const description =
  "A walk through the branching points that separate the camps arguing about how fast to build frontier AI.";
const canonicalURL = new URL(Astro.url.pathname, Astro.url);
const socialImageURL = new URL("/card.png", Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3b0d03" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pacing the Frontier, An Agenda" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1604" />
    <meta property="og:image:height" content="842" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Illustration of control surfaces for pacing AI development" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Illustration of control surfaces for pacing AI development" />

    <style is:global set:html={iconCSS}></style>

    <Font cssVariable="--font-satoshi" preload />
    <Font cssVariable="--font-body-serif" preload />
    <Font cssVariable="--font-plex-mono" />
  </head>

  <body class="font-serif text-(length:--prose-size) leading-[1.6] md:pl-70 md:h-dvh md:overflow-hidden">
    <!-- The essay's sidebar (src/pages/index.astro): same width, padding
         and type, with the quiz's title and its opening paragraph in place
         of the table of contents. Fixed down the left from md; a block
         across the top below it, where the title runs on one line to
         leave room for the screen beneath. -->
    <aside class="select-none bg-sidebar text-background font-sans text-base md:fixed md:inset-y-0 md:left-0 md:w-70 md:overflow-hidden md:flex md:flex-col">
      <!-- The title block, subtitle and button are the essay sidebar's
           (src/layouts/EssayLayout.astro), class for class, so the two
           sit identically. -->
      <div class="p-6 pt-6 pb-2 md:pt-[clamp(0.75rem,1.8vh,1.4rem)] md:pb-[clamp(0.5rem,1.6vh,1.25rem)]">
        <h1 class="text-4xl md:text-[clamp(1.6rem,5.2vh,3rem)] font-light grid gap-2 md:gap-[clamp(0.15rem,0.5vh,0.5rem)] md:leading-none">
          <span>Ways</span>
          <span class="-ml-0.5">to</span>
          <span>Pace</span>
        </h1>
        <div class="mt-5 md:mt-[clamp(0.75rem,1.8vh,1.25rem)] text-lg md:text-[clamp(1rem,2.4vh,1.5rem)] font-light">A Quiz</div>
        <a
          class="inline-flex items-center gap-2 mt-6 mb-4 md:mt-[clamp(1.2rem,3.4vh,3rem)] md:mb-[clamp(0.6rem,1.8vh,1.75rem)] px-4 py-2 border rounded-md border-(--color-pace-how-bg) text-(--color-pace-how-bg) hover:border-(--color-why-pace-bg) hover:text-(--color-why-pace-bg) transition-colors"
          href="/"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="1em" height="1em" fill="currentColor" aria-hidden="true">
            <path d="M168.49,199.51a12,12,0,0,1-17,17l-80-80a12,12,0,0,1,0-17l80-80a12,12,0,0,1,17,17L97,128Z"></path>
          </svg>
          Back to paper
        </a>
      </div>
      <div class="px-6 mt-4 md:mt-[clamp(0.5rem,1.8vh,1.25rem)] grid gap-6 md:gap-[clamp(0.5rem,1.8vh,1.5rem)] md:text-[clamp(0.88rem,2.1vh,1.1rem)] md:leading-[1.45] antialiased">
        <p>
          Experts who mostly agree that unrestricted AI progress poses significant risks to human societies still
          disagree on major branching points of the pacing debate.
        </p>
        <p>
          We created this interactive tool as an invitation for you to consider your position on these branching points
          and to give you an opportunity to compare others' views with your own.
        </p>
      </div>
      <!-- The map's foot: Quiz.jsx renders the note and Start again here
           while the map is showing. Hidden below md, where the map covers
           the whole screen and the sidebar with it. -->
      <div id="sidebar-foot" class="hidden md:block mt-auto px-6 pb-[clamp(0.75rem,2.4vh,1.5rem)] pt-4"></div>
    </aside>

    <!-- client:only, not client:load: the option order is shuffled per
         visit, so a server render would never match the client's. -->
    <main
      tabindex="0"
      class="flex w-full max-w-[860px] mx-auto flex-col pt-16 pb-7 px-(--x-padding) text-(length:--prose-size) min-h-dvh md:min-h-0 md:h-dvh md:pt-[clamp(1.5rem,5vh,4rem)] md:overflow-hidden"
    >
      <Quiz client:only="preact" />
    </main>
  </body>
</html>
