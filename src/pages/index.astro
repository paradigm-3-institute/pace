---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import NavItem from "../components/NavItem.astro";
import Section from "../components/Section.astro";

const sectionMeta = [
  {
    slug: "01-introduction",
    id: "introduction",
    label: "Introduction",
    bgClass: "bg-introduction",
    textClass: "text-conclusion",
  },
  { slug: "02-why-pace", id: "why-pace", label: "Why Pace?", bgClass: "bg-why-pace", textClass: "text-conclusion" },
  { slug: "03-pace-what", id: "pace-what", label: "Pace What?", bgClass: "bg-pace-what", textClass: "text-conclusion" },
  { slug: "04-pace-how", id: "pace-how", label: "Pace How?", bgClass: "bg-pace-how", textClass: "text-introduction" },
  {
    slug: "05-then-what",
    id: "then-what",
    label: "Then What?",
    bgClass: "bg-then-what",
    textClass: "text-introduction",
  },
  {
    slug: "06-conclusion",
    id: "conclusion",
    label: "Conclusion",
    bgClass: "bg-conclusion",
    textClass: "text-introduction",
  },
] as const;

const sections = await Promise.all(
  sectionMeta.map(async ({ slug, ...meta }) => ({
    ...meta,
    content: await render(await getEntry("sections", slug)),
  })),
);
---

<Layout
  title="How to Pace The Frontier"
  description="A field guide to spending your effort budget across a long distance."
>
  <aside class="hidden md:block fixed w-76 h-dvh overflow-auto">
    <hgroup class="p-7 bg-[#FAFAFA]">
      <h1 class="text-5xl capitalize font-light grid gap-2">
        <div>How</div>
        <div class="-ml-2">to</div>
        <div>pace</div>
        <div class="-ml-2">the</div>
        <div>frontier</div>
      </h1>
      <!-- <p class="mt-6 italic text-2xl">A Research Agenda</p> -->
    </hgroup>
    <nav>
      <ul class="text-3xl mb-8">
        {
          sections.map(({ id, label, textClass, bgClass }) => (
            <NavItem href={`#${id}`} bgClass={bgClass} label={label} textClass={textClass || bgClass} sectionId={id} />
          ))
        }
      </ul>
    </nav>
  </aside>

  <main class="w-full md:pl-76 py-24">
    <article class="bg-white mx-24 rounded-xl py-24">
      {
        sections.map(({ id, label, textClass, content }) => (
          <Section id={id} title={label} textClass={textClass} content={content} />
        ))
      }
    </article>
  </main>
</Layout>

<script>
  const navItems = document.querySelectorAll<HTMLLIElement>(".nav-item");
  const sections = document.querySelectorAll<HTMLElement>("main section[id]");
  const headings = document.querySelectorAll<HTMLElement>("main section[id] h2");

  let activeId: string | null = null;

  const setActive = (id: string) => {
    if (id === activeId) return;
    activeId = id;
    navItems.forEach((item) => {
      item.classList.toggle("is-active", item.dataset.sectionId === id);
    });
  };

  const applyHash = () => {
    const id = window.location.hash.slice(1);
    if (id) setActive(id);
  };

  const hashId = window.location.hash.slice(1);
  const initialId = [...sections].some((section) => section.id === hashId) ? hashId : sections[0]?.id;

  if (initialId) {
    navItems.forEach((item) => item.classList.add("no-transition"));
    setActive(initialId);
    void document.body.offsetHeight;
    requestAnimationFrame(() => {
      navItems.forEach((item) => item.classList.remove("no-transition"));
    });
  }

  window.addEventListener("hashchange", applyHash);

  let lastSeenId: string | null = initialId ?? null;
  let idleTimer: ReturnType<typeof setTimeout>;

  const scheduleActivate = () => {
    clearTimeout(idleTimer);
    idleTimer = setTimeout(() => {
      if (lastSeenId && lastSeenId !== activeId) {
        if (window.location.hash.slice(1) !== lastSeenId) {
          history.replaceState(null, "", `#${lastSeenId}`);
        }
        setActive(lastSeenId);
      }
    }, 300);
  };

  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const id = entry.target.closest("section")?.id;
      if (!id) continue;
      lastSeenId = id;
    }
  });

  headings.forEach((heading) => observer.observe(heading));

  window.addEventListener("scroll", scheduleActivate, { passive: true });
</script>
