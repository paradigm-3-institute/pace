---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import NavItem from "../components/NavItem.astro";
import Section from "../components/Section.astro";
import { Content as Intro } from "../content/index.md";

const sectionMeta = [
  {
    slug: "01-introduction",
    id: "introduction",
    label: "Introduction",
    textClass: "text-light",
  },
  { slug: "02-why-pace", id: "why-pace", label: "Why Pace?", textClass: "text-light" },
  { slug: "03-pace-what", id: "pace-what", label: "Pace What?", textClass: "text-light" },
  { slug: "04-pace-how", id: "pace-how", label: "Pace How?", textClass: "text-light" },
  {
    slug: "05-then-what",
    id: "then-what",
    label: "Then What?",
    textClass: "text-dark antialiased",
  },
  {
    slug: "06-conclusion",
    id: "conclusion",
    label: "Conclusion",
    textClass: "text-dark antialiased",
  },
  {
    slug: "07-call-to-action",
    id: "call-to-action",
    label: "Call To Action",
    textClass: "text-dark antialiased",
  },
] as const;

const sections = await Promise.all(
  sectionMeta.map(async ({ slug, ...meta }) => ({
    ...meta,
    content: await render(await getEntry("sections", slug)),
  })),
);
---

<Layout
  title="How to Pace The Frontier"
  description="A field guide to spending your effort budget across a long distance."
>
  <aside
    class="md:fixed w-full pb-2 md:w-70 md:h-dvh overflow-auto bg-sidebar text-background border-x-2 md:border-l-0 border-sidebar"
  >
    <a href="#">
      <hgroup class="p-7 pb-8">
        <h1 class="text-5xl capitalize font-light grid gap-2">
          <div>How</div>
          <div class="-ml-2">to</div>
          <div>pace</div>
          <div class="-ml-2">the</div>
          <div>frontier</div>
        </h1>
      </hgroup>
    </a>
    <nav>
      <ul class="text-3xl">
        {
          sections.map(({ id, label, textClass }) => (
            <NavItem href={`#${id}`} label={label} textClass={textClass} sectionId={id} />
          ))
        }
      </ul>
    </nav>
  </aside>

  <main class="w-full md:pl-70 lg:pl-77 lg:pr-6 lg:py-24 border-2 border-sidebar md:border-none">
    <article
      class="prose max-w-222 2xl:max-w-260 text-[17px] md:text-[19px] 2xl:text-[21px] bg-background mx-auto py-8 md:py-16 lg:border-2 border-sidebar -outline-offset-8 outline-2 outline-sidebar"
    >
      <div class="px-8 md:px-16">
        <hgroup>
          <h1>How to Pace the Frontier</h1>
          <p>A Research Agenda</p>
        </hgroup>
        <div class="text-center max-w-120 mx-auto mb-16">
          Raymond Douglas, Charles Dillon, Nikola Datkova, Gavin Leech, Mathias Kirk Bonde & Shahar Avin
        </div>
        <blockquote class="mb-16!">
          <p>
            “Society at large may need the option to buy time to address emerging risks, develop security measures, and
            strengthen oversight. But each company—and country—is under intense competitive pressure not to unilaterally
            slow that acceleration. And today, the world lacks the technical and governance tools to deliberately pace
            frontier-wide progress.”
          </p>
        </blockquote>
        <Intro />
      </div>
      {
        sections.map(({ id, label, textClass, content }) => (
          <Section id={id} title={label} textClass={textClass} content={content} />
        ))
      }
    </article>
  </main>

  <a
    href="#"
    class="md:hidden fixed -bottom-2 -right-2 bg-background p-4 border-2 border-sidebar text-sidebar outline-2 outline-sidebar -outline-offset-8"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
        d="M10.586 3l-6.586 6.586a2 2 0 0 0 -.434 2.18l.068 .145a2 2 0 0 0 1.78 1.089h2.586v7a2 2 0 0 0 2 2h4l.15 -.005a2 2 0 0 0 1.85 -1.995l-.001 -7h2.587a2 2 0 0 0 1.414 -3.414l-6.586 -6.586a2 2 0 0 0 -2.828 0z"
      ></path></svg
    >
  </a>
</Layout>
