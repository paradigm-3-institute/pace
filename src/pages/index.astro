---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import NavItem from "../components/NavItem.astro";
import Section from "../components/Section.astro";

const sectionMeta = [
  { slug: "01-introduction", id: "introduction", label: "Introduction", bgClass: "bg-introduction" },
  { slug: "02-why-pace", id: "why-pace", label: "Why Pace?", bgClass: "bg-why-pace" },
  { slug: "03-pace-what", id: "pace-what", label: "Pace What?", bgClass: "bg-pace-what" },
  { slug: "04-pace-how", id: "pace-how", label: "Pace How?", bgClass: "bg-pace-how" },
  { slug: "05-then-what", id: "then-what", label: "Then What?", bgClass: "bg-then-what" },
  { slug: "06-conclusion", id: "conclusion", label: "Conclusion", bgClass: "bg-conclusion" },
] as const;

const sections = await Promise.all(
  sectionMeta.map(async ({ slug, ...meta }) => ({
    ...meta,
    content: await render(await getEntry("sections", slug)),
  })),
);
---

<Layout
  title="How to Pace The Frontier"
  description="A field guide to spending your effort budget across a long distance."
>
  <aside class="hidden md:block fixed w-76 h-dvh overflow-auto bg-white">
    <hgroup class="p-4 px-6">
      <h1 class="text-5xl capitalize font-light grid gap-2">
        <div>How</div>
        <div class="-ml-2">to</div>
        <div>pace</div>
        <div class="-ml-2">the</div>
        <div>frontier</div>
      </h1>
      <p class="mt-6 mb-10 italic text-2xl">A Research Agenda</p>
    </hgroup>
    <nav>
      <ul class="text-3xl mb-8">
        {sections.map(({ id, label, bgClass }) => <NavItem href={`#${id}`} bgClass={bgClass} label={label} />)}
      </ul>
    </nav>
  </aside>

  <main class="w-full md:pl-76">
    <article>
      {
        sections.map(({ id, label, bgClass, content }) => (
          <Section id={id} title={label} bgClass={bgClass} content={content} />
        ))
      }
    </article>
  </main>
</Layout>
