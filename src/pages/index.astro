---
import { getEntry, render } from "astro:content";
import EssayLayout from "../layouts/EssayLayout.astro";
import Section from "../components/Section.astro";
import Affiliations from "../components/Affiliations.astro";
import { sectionMeta } from "../sections";
import { Content as Intro } from "../content/index.md";

const sections = await Promise.all(
  sectionMeta
    .filter(({ page }) => page === "/")
    .map(async ({ slug, ...meta }) => ({
      ...meta,
      content: await render(await getEntry("sections", slug)),
    })),
);

const appendices = sectionMeta.find(({ page }) => page === "/appendices")!;
---

<EssayLayout
  title="Pacing The Frontier: An Agenda"
  description="How to think about how to pace"
  homeHref="#"
>
  <div class="padded">
    <hgroup>
      <h1>Pacing the Frontier</h1>
      <p>A Framework & Research Agenda</p>
    </hgroup>
    <div class="grid gap-2 md:gap-6 mb-12 md:mb-16 font-sans text-(--color-conclusion-bg)">
      <div class="text-right font-semibold text-balance">
        by Raymond Douglas, Charles Dillon, Nikola Moore, Gavin Leech, Shahar Avin<sup>✝</sup>
      </div>
      <div class="text-right ml-auto max-w-lg text-balance">
        ...and Mathias&nbsp;Kirk&nbsp;Bonde, Rohit&nbsp;Krishnan, Noah&nbsp;Perez, Nathan&nbsp;Young,
        Cormac&nbsp;Slade&nbsp;Byrd, Stephen&nbsp;Casper, Jan&nbsp;Kulveit, & David&nbsp;Duvenaud<sup
          ><a href="#user-content-fn-1" id="user-content-fnref-1" data-footnote-ref aria-describedby="footnote-label"
            >1</a
          ></sup
        >
      </div>
    </div>
    <Intro />
    <!-- Hand-rendered copy of the GFM footnote markup, since this byline
         lives in the template rather than in a markdown section. Below the
         breakpoint the same content opens as a lightbox instead, so the
         affiliations are one tap away rather than a scroll down the page. -->
    <section data-footnotes class="footnotes byline-footnotes">
      <h2 class="sr-only" id="footnote-label">
        Footnotes
      </h2>
      <ol>
        <li id="user-content-fn-1">
          <Affiliations backref />
        </li>
      </ol>
    </section>
    <dialog id="affiliations-dialog" class="affiliations-dialog" aria-label="Author affiliations">
      <div class="affiliations-dialog-body">
        <form method="dialog">
          <button class="affiliations-dialog-close" aria-label="Close">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="1em" height="1em" fill="currentColor" aria-hidden="true">
              <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"></path>
            </svg>
          </button>
        </form>
        <p class="affiliations-dialog-title">Affiliations</p>
        <Affiliations />
      </div>
    </dialog>
  </div>
  {sections.map(({ id, label, textClass, content }) => (
    <Section id={id} title={label} textClass={textClass} content={content} />
  ))}
  <Section id={appendices.id} title={appendices.label} textClass={appendices.textClass}>
    <p>
      The full list of open questions, the longlist of pacing interventions, and the bibliography are collected{" "}
      <a href={appendices.page}>on their own page</a>.
    </p>
  </Section>
</EssayLayout>

<script>
  /* On phones the affiliations footnote opens as a lightbox over the byline
     instead of sending the reader to the bottom of the intro. Wide screens
     keep the ordinary footnote jump, and so does anyone without JS: the
     footnote stays in the page and is only hidden once this has run. */
  const dialog = document.getElementById("affiliations-dialog") as HTMLDialogElement | null;
  const ref = document.getElementById("user-content-fnref-1");
  const compact = window.matchMedia("(width < 48rem)");

  if (dialog && ref && typeof dialog.showModal === "function") {
    document.documentElement.dataset.affiliationsDialog = "";

    ref.addEventListener("click", (event) => {
      if (!compact.matches) return;
      event.preventDefault();
      dialog.showModal();
    });

    /* A click that lands on the dialog itself came from the backdrop, since
       the card's own padding is on the panel inside it. */
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    /* Rotating to a wide screen with it open would leave a lightbox on a
       layout that shows the footnote anyway. */
    compact.addEventListener("change", () => {
      if (!compact.matches && dialog.open) dialog.close();
    });
  }
</script>
