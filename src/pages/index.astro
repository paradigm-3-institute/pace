---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

const introduction = await render(await getEntry("sections", "01-introduction"));
const whyPace = await render(await getEntry("sections", "02-why-pace"));
const paceWhat = await render(await getEntry("sections", "03-pace-what"));
const paceHow = await render(await getEntry("sections", "04-pace-how"));
const thenWhat = await render(await getEntry("sections", "05-then-what"));
const conclusion = await render(await getEntry("sections", "06-conclusion"));
---

<Layout title="Pacing" description="A field guide to spending your effort budget across a long distance.">
  <aside class="hidden md:block fixed w-80 h-dvh overflow-auto bg-white">
    <hgroup class="p-4 px-6">
      <h1 class="text-5xl capitalize font-light grid gap-2">
        <div>How</div>
        <div class="-ml-2">to</div>
        <div>pace</div>
        <div class="-ml-2">the</div>
        <div>frontier</div>
      </h1>
      <p class="mt-6 mb-10 italic text-2xl">A Research Agenda</p>
    </hgroup>
    <nav>
      <ul class="text-3xl *:px-6 *:py-4 mb-8">
        <li class="bg-introduction/10 text-introduction">
          <a href="#introduction">Introduction</a>
        </li>
        <li class="bg-why-pace/10 text-why-pace">
          <a href="#why-pace">Why Pace?</a>
        </li>
        <li class="bg-pace-what/10 text-pace-what">
          <a href="#pace-what">Pace What?</a>
        </li>
        <li class="bg-pace-how/10 text-pace-how">
          <a href="#pace-how">Pace How?</a>
        </li>
        <li class="bg-then-what/10 text-then-what">
          <a href="#then-what">Then What?</a>
        </li>
        <li class="bg-conclusion/10 text-conclusion">
          <a href="#conclusion">Conclusion</a>
        </li>
      </ul>
    </nav>
  </aside>

  <main class="px-6 md:px-10 md:pl-90 w-full py-32">
    <header class="max-w-200 mx-auto mb-16 border-b border-slate-200 pb-10 dark:border-slate-800">
      <h1 class="font-serif text-4xl leading-tight font-bold text-slate-900 sm:text-5xl dark:text-white">Pacing</h1>
      <p class="mt-4 max-w-xl text-lg text-slate-500 dark:text-slate-400">
        A field guide to spending a fixed effort budget across a distance that does not care how you feel at the start.
      </p>
    </header>

    <article class="max-w-200 mx-auto">
      <section id="introduction" class="mb-16 scroll-mt-10 rounded-lg p-6 bg-introduction/5">
        <h2 class="text-introduction">Introduction</h2>
        <introduction.Content />
      </section>
      <section id="why-pace" class="mb-16 scroll-mt-10 rounded-lg p-6 bg-why-pace/5">
        <h2 class="text-why-pace">Why Pace?</h2>
        <whyPace.Content />
      </section>
      <section id="pace-what" class="mb-16 scroll-mt-10 rounded-lg p-6 bg-pace-what/5">
        <h2 class="text-pace-what">Pace What?</h2>
        <paceWhat.Content />
      </section>
      <section id="pace-how" class="mb-16 scroll-mt-10 rounded-lg p-6 bg-pace-how/5">
        <h2 class="text-pace-how">Pace How?</h2>
        <paceHow.Content />
      </section>
      <section id="then-what" class="mb-16 scroll-mt-10 rounded-lg p-6 bg-then-what/5">
        <h2 class="text-then-what">Then What?</h2>
        <thenWhat.Content />
      </section>
      <section id="conclusion" class="mb-16 last:mb-0 scroll-mt-10 rounded-lg p-6 bg-conclusion/5">
        <h2 class="text-conclusion">Conclusion</h2>
        <conclusion.Content />
      </section>
    </article>
  </main>
</Layout>
