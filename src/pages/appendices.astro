---
import { getEntry, render } from "astro:content";
import EssayLayout from "../layouts/EssayLayout.astro";
import Section from "../components/Section.astro";
import { sectionMeta } from "../sections";

const appendices = sectionMeta.find(({ page }) => page === "/appendices")!;
const content = await render(await getEntry("sections", appendices.slug));
---

<EssayLayout
  title="Appendices — Pacing The Frontier"
  description="Open questions, a full list of pacing interventions, and a bibliography."
  flushTop
>
  <Section id={appendices.id} title={appendices.label} textClass={appendices.textClass} content={content} />
</EssayLayout>
