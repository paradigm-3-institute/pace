---
import Layout from "./Layout.astro";
import NavItem from "../components/NavItem.astro";
import { sectionMeta, navHref, sectionTitle } from "../sections";

interface Props {
  title: string;
  description?: string;
  /* Where the sidebar's title links. The index uses "#" so it scrolls to the
     top instead of reloading. */
  homeHref?: string;
  /* For a page that opens straight into a section banner (the appendices):
     drop the article's top padding so the banner meets the top of the page. */
  flushTop?: boolean;
}

const { title, description, homeHref = "/", flushTop = false } = Astro.props;
---

<Layout title={title} description={description}>
  <aside id="site-nav" class="site-nav md:fixed w-full pb-2 md:pb-0 md:w-70 md:h-dvh md:overflow-hidden md:flex md:flex-col bg-sidebar text-background md:border-r-2 border-sidebar select-none">
    <a href={homeHref}>
      <div class="p-6 pt-10 pb-2 md:pt-[clamp(1.25rem,3vh,2.25rem)] md:pb-[clamp(0.5rem,1.6vh,1.25rem)]">
        <div class="text-4xl md:text-[clamp(1.6rem,5.2vh,3rem)] font-light grid gap-2 md:gap-[clamp(0.15rem,0.5vh,0.5rem)] md:leading-none">
          <div>Pacing</div>
          <div class="-ml-0.5">the</div>
          <div>Frontier</div>
        </div>
        <div class="mt-5 md:mt-[clamp(0.75rem,1.8vh,1.25rem)] text-lg md:text-[clamp(1rem,2.4vh,1.5rem)] font-light">An Agenda</div>
        <a
          class="inline-flex items-center gap-2 mt-6 mb-4 md:mt-[clamp(1.2rem,3.4vh,3rem)] md:mb-[clamp(0.6rem,1.8vh,1.75rem)] px-4 py-2 border rounded-md border-(--color-pace-how-bg) text-(--color-pace-how-bg) hover:border-(--color-why-pace-bg) hover:text-(--color-why-pace-bg) transition-colors"
          href="/quiz"
        >
          Choose your pace
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="1em" height="1em" fill="currentColor" aria-hidden="true">
            <path d="M184.49,136.49l-80,80a12,12,0,0,1-17-17L159,128,87.51,56.49a12,12,0,1,1,17-17l80,80A12,12,0,0,1,184.49,136.49Z"></path>
          </svg>
        </a>
      </div>
    </a>
    <nav class="md:flex-1 md:min-h-0 md:flex md:flex-col">
      <ul class="text-[1.45rem] leading-[1.15] md:leading-normal md:text-[clamp(1.05rem,2.8vh,1.75rem)] md:flex-1 md:flex md:flex-col">
        {sectionMeta.map((section) => (
          <NavItem
            href={navHref(section)}
            label={sectionTitle(section)}
            textClass={section.textClass}
            sectionId={section.id}
          />
        ))}
      </ul>
    </nav>
  </aside>
  <div id="nav-scrim" class="nav-scrim"></div>

  <main class="w-full md:pl-70 lg:pl-77 lg:pr-6 lg:py-24">
    <!-- Below the breakpoint the sidebar is a drawer, and this is its handle:
         a tab peeking out of the left edge that rides out with the panel when
         it opens. It sits outside the article so that it stays live while the
         article behind the drawer is inert, and before it so that it comes
         first for a keyboard. It is hidden until the document is marked as
         having JS, so without it the sidebar stays the block at the top of
         the page it has always been. -->
    <button
      id="nav-toggle"
      type="button"
      class="nav-toggle"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg class="nav-toggle-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"></path>
      </svg>
      <svg class="nav-toggle-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z"></path>
      </svg>
    </button>
    <article
      class:list={[
        "prose max-w-222 2xl:max-w-260 bg-background mx-auto pb-8 md:pb-16 lg:border-2 border-sidebar md:-outline-offset-8 md:outline-2 outline-sidebar rounded-sm",
        flushTop ? "flush-top pt-0" : "pt-8 md:pt-16",
      ]}
    >
      <slot />
    </article>
  </main>
</Layout>

<script>
  /* Below the breakpoint the sidebar slides in from the left instead of
     standing between the reader and the first paragraph. It is a drawer only
     while the html element is marked, which Layout's head does before the
     first paint; with no JS neither script runs, and the sidebar stays in the
     page with every section one tap away. */
  const nav = document.getElementById("site-nav");
  const toggle = document.getElementById("nav-toggle");
  const scrim = document.getElementById("nav-scrim");
  const main = document.querySelector("main");
  const article = document.querySelector("main > article");
  const compact = window.matchMedia("(width < 48rem)");

  if (nav && toggle && scrim) {
    const setOpen = (open: boolean) => {
      document.documentElement.toggleAttribute("data-nav-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      /* Nothing under the scrim should take focus while the drawer is over it;
         the tab is outside the article so that it keeps working. */
      article?.toggleAttribute("inert", open);
      if (!open && nav.contains(document.activeElement)) toggle.focus();
    };

    toggle.addEventListener("click", () => {
      setOpen(!document.documentElement.hasAttribute("data-nav-open"));
    });

    scrim.addEventListener("click", () => setOpen(false));

    /* Every link in here goes to a section of this page or the next one;
       either way the drawer has done its job. */
    nav.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    /* The tab rests at the first banner and locks to the top of the screen
       from there, the way the banner itself does, so it needs to know how far
       down the page that banner starts. The distance goes on as a margin and
       comes straight back off below, so the tab keeps a place in the flow
       without taking any room in it. */
    const first = document.querySelector(".prose .exec-summary, .prose > section");

    if (first && main) {
      const place = () => {
        const top = main.getBoundingClientRect().top + parseFloat(getComputedStyle(main).paddingTop);
        const rest = Math.max(0, first.getBoundingClientRect().top - top);
        toggle.style.setProperty("--nav-tab-rest", `${Math.round(rest)}px`);
        /* Only now is it safe to show: a resize observation is delivered before
           the frame it belongs to is painted, so the tab's first appearance is
           already in the right place. */
        document.documentElement.dataset.navPlaced = "";
      };

      /* Fires once to place it, and again whenever the page above it reflows:
         a rotation, a font arriving late. */
      new ResizeObserver(place).observe(main);
    } else {
      /* Nothing to rest at: better at the top of the page than not at all. */
      document.documentElement.dataset.navPlaced = "";
    }

    /* Rotating to a wide screen would otherwise leave the page inert behind a
       sidebar that is on screen anyway. */
    compact.addEventListener("change", () => {
      if (!compact.matches) setOpen(false);
    });
  }
</script>
