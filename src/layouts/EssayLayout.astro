---
import Layout from "./Layout.astro";
import NavItem from "../components/NavItem.astro";
import { sectionMeta, navHref } from "../sections";

interface Props {
  title: string;
  description?: string;
  /* Where the sidebar's title links. The index uses "#" so it scrolls to the
     top instead of reloading. */
  homeHref?: string;
  /* For a page that opens straight into a section banner (the appendices):
     drop the article's top padding so the banner meets the top of the page. */
  flushTop?: boolean;
}

const { title, description, homeHref = "/", flushTop = false } = Astro.props;
---

<Layout title={title} description={description}>
  <aside class="md:fixed w-full pb-2 md:pb-0 md:w-70 md:h-dvh md:overflow-hidden md:flex md:flex-col bg-sidebar text-background border-x-2 md:border-l-0 border-sidebar select-none">
    <a href={homeHref}>
      <div class="p-6 pt-10 pb-2 md:pt-[clamp(1.25rem,3vh,2.25rem)] md:pb-[clamp(0.5rem,1.6vh,1.25rem)]">
        <div class="text-4xl md:text-[clamp(1.6rem,5.2vh,3rem)] font-light grid gap-2 md:gap-[clamp(0.15rem,0.5vh,0.5rem)] md:leading-none">
          <div>Pacing</div>
          <div class="-ml-0.5">the</div>
          <div>Frontier</div>
        </div>
        <div class="mt-5 md:mt-[clamp(0.75rem,1.8vh,1.25rem)] text-lg md:text-[clamp(1rem,2.4vh,1.5rem)] font-light">An Agenda</div>
        <a
          class="inline-flex items-center gap-2 mt-6 mb-4 md:mt-[clamp(1.2rem,3.4vh,3rem)] md:mb-[clamp(0.6rem,1.8vh,1.75rem)] px-4 py-2 border rounded-md border-(--color-pace-how-bg) text-(--color-pace-how-bg) hover:border-(--color-why-pace-bg) hover:text-(--color-why-pace-bg) transition-colors"
          href="/quiz"
        >
          Take the quiz
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="1em" height="1em" fill="currentColor" aria-hidden="true">
            <path d="M184.49,136.49l-80,80a12,12,0,0,1-17-17L159,128,87.51,56.49a12,12,0,1,1,17-17l80,80A12,12,0,0,1,184.49,136.49Z"></path>
          </svg>
        </a>
      </div>
    </a>
    <nav class="md:flex-1 md:min-h-0 md:flex md:flex-col">
      <ul class="text-[1.45rem] leading-[1.15] md:leading-normal md:text-[clamp(1.05rem,2.8vh,1.75rem)] md:flex-1 md:flex md:flex-col">
        {sectionMeta.map((section) => (
          <NavItem
            href={navHref(section)}
            label={section.label}
            textClass={section.textClass}
            sectionId={section.id}
          />
        ))}
      </ul>
    </nav>
  </aside>

  <main class="w-full md:pl-70 lg:pl-77 lg:pr-6 lg:py-24 border-2 border-sidebar md:border-none">
    <article
      class:list={[
        "prose max-w-222 2xl:max-w-260 bg-background mx-auto pb-8 md:pb-16 lg:border-2 border-sidebar -outline-offset-8 outline-2 outline-sidebar rounded-sm",
        flushTop ? "flush-top pt-0" : "pt-8 md:pt-16",
      ]}
    >
      <slot />
    </article>
  </main>

  <a
    href="#"
    class="md:hidden fixed -bottom-2 -right-2 bg-background p-4 border-2 border-sidebar text-sidebar outline-2 outline-sidebar -outline-offset-8 z-100"
    aria-label="Back to top"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
      <path d="M10.586 3l-6.586 6.586a2 2 0 0 0 -.434 2.18l.068 .145a2 2 0 0 0 1.78 1.089h2.586v7a2 2 0 0 0 2 2h4l.15 -.005a2 2 0 0 0 1.85 -1.995l-.001 -7h2.587a2 2 0 0 0 1.414 -3.414l-6.586 -6.586a2 2 0 0 0 -2.828 0z"></path>
    </svg>
  </a>
</Layout>
