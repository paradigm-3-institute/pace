---
interface Props {
  href: string;
  textClass: string;
  label: string;
  sectionId: string;
}

const { href, textClass, label, sectionId } = Astro.props;
---

<li class:list={[textClass, "nav-item last:rounded-b-3xl md:last:rounded-bl-none"]} data-section-id={sectionId}>
  <a class="px-7 py-5 block" href={href}>{label}</a>
</li>

<style>
  .nav-item {
    background-color: var(--nav-bg, transparent);
    transition: background-color 300ms ease;
  }

  .nav-item.is-active {
    background: transparent;
    transition: background-color 300ms ease 600ms;
  }
</style>
