---
interface Props {
  href: string;
  textClass: string;
  label: string;
  sectionId: string;
}

const { href, textClass, label, sectionId } = Astro.props;
---

<li
  class:list={[textClass, "nav-item flex-1 min-h-0 flex"]}
  data-section-id={sectionId}
  style={`background-color: var(--color-${sectionId}-bg);`}
>
  <a class="px-6 py-3 flex-1 flex items-center" href={href}>
    {label}
  </a>
</li>

<style>
  .nav-item {
    border-top: solid 1px var(--color-sidebar);
    border-bottom: solid 1px var(--color-sidebar);
  }
</style>
