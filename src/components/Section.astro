---
import type { CollectionEntry, RenderResult } from "astro:content";

interface Props {
  id: string;
  title: string;
  textClass: string;
  content: RenderResult;
}

const { id, title, textClass, content } = Astro.props;
const { Content } = content;
---

<section id={id} class:list={["mb-12 -scroll-mt-8 last:mb-0"]}>
  <h2 style={`background: var(--color-${id}-bg);`} class={textClass}>{title}</h2>
  <div class="mx-auto padded">
    <Content />
  </div>
</section>
