---
import type { RenderResult } from "astro:content";

interface Props {
  id: string;
  title: string;
  textClass: string;
  /* Rendered markdown for the body; omit to use the slot instead. */
  content?: RenderResult;
}

const { id, title, textClass, content } = Astro.props;
const Content = content?.Content;
---

<section id={id} class:list={["mb-12 -scroll-mt-8 last:mb-0"]}>
  <h2 style={`background: color-mix(in oklab, var(--color-${id}-bg), white 15%);`} class={textClass}>
    {title}
  </h2>
  <div class="mx-auto padded">
    {Content ? <Content /> : <slot />}
  </div>
</section>
