---
import type { CollectionEntry, RenderResult } from "astro:content";

interface Props {
  id: string;
  title: string;
  bgClass: string;
  content: RenderResult;
}

const { id, title, bgClass, content } = Astro.props;
const { Content } = content;
---

<section id={id} class:list={["py-12 last:mb-0 text-white/90", bgClass]}>
  <div class="max-w-200 mx-auto px-6 md:px-10">
    <h2>{title}</h2>
    <Content />
  </div>
</section>
