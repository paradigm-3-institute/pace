---
const colorVars = [
  { name: "--color-from", label: "Gradient From" },
  { name: "--color-to", label: "Gradient To" },
  { name: "--color-foreground", label: "Foreground" },
  { name: "--color-background", label: "Background" },
  { name: "--color-light", label: "Light Text" },
  { name: "--color-dark", label: "Dark Text" },
] as const;
---

<button
  id="color-editor-toggle"
  type="button"
  aria-label="Edit page colors"
  class="fixed top-0 right-0 z-50 flex h-11 w-11 items-center justify-center bg-white rounded-bl-xl"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-foreground"
  >
    <circle cx="13.5" cy="6.5" r=".5"></circle>
    <circle cx="17.5" cy="10.5" r=".5"></circle>
    <circle cx="8.5" cy="7.5" r=".5"></circle>
    <circle cx="6.5" cy="12.5" r=".5"></circle>
    <path
      d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.4-.3-.4-.5-.9-.5-1.4 0-1.1.9-2 2-2h2c3.3 0 6-2.7 6-6 0-4.4-4-8-10-8z"
    ></path>
  </svg>
</button>

<div
  id="color-editor-panel"
  class="fixed -top-1 -right-1 z-50 hidden w-64 bg-white p-4 border-4 border-from rounded-bl-3xl"
>
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-sm font-semibold text-foreground">Page colors</h2>
    <button id="color-editor-reset" type="button" class="text-xs text-foreground/70 hover:text-foreground underline">
      Reset
    </button>
  </div>
  <ul class="flex flex-col gap-2">
    {
      colorVars.map(({ name, label }) => (
        <li class="flex items-center justify-between gap-3">
          <label for={`color-input-${name}`} class="text-xs text-foreground">
            {label}
          </label>
          <input
            id={`color-input-${name}`}
            type="color"
            data-color-var={name}
            class="h-7 w-10 cursor-pointer rounded border border-black/10 bg-transparent p-0"
          />
        </li>
      ))
    }
  </ul>
</div>

<script>
  const STORAGE_KEY = "page-color-overrides";

  const toggleButton = document.getElementById("color-editor-toggle");
  const panel = document.getElementById("color-editor-panel");
  const resetButton = document.getElementById("color-editor-reset");
  const inputs = document.querySelectorAll<HTMLInputElement>("[data-color-var]");

  const rgbToHex = (rgb: string): string => {
    const match = rgb.match(/\d+/g);
    if (!match) return "#000000";
    return (
      "#" +
      match
        .slice(0, 3)
        .map((n) => Number(n).toString(16).padStart(2, "0"))
        .join("")
    );
  };

  const getCurrentValue = (varName: string): string => {
    const raw = getComputedStyle(document.documentElement).getPropertyValue(varName).trim();
    if (!raw) return "#000000";
    return raw.startsWith("#") ? raw : rgbToHex(raw);
  };

  const applyOverrides = (overrides: Record<string, string>) => {
    for (const [varName, value] of Object.entries(overrides)) {
      document.documentElement.style.setProperty(varName, value);
    }
  };

  const loadOverrides = (): Record<string, string> => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch {
      return {};
    }
  };

  const saveOverrides = (overrides: Record<string, string>) => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(overrides));
  };

  const overrides = loadOverrides();
  applyOverrides(overrides);

  inputs.forEach((input) => {
    const varName = input.dataset.colorVar;
    if (!varName) return;
    const value = overrides[varName] ?? getCurrentValue(varName);
    input.value = value;
    overrides[varName] = value;

    input.addEventListener("input", () => {
      document.documentElement.style.setProperty(varName, input.value);
      overrides[varName] = input.value;
      saveOverrides(overrides);
      window.dispatchEvent(new Event("colors-updated"));
    });
  });

  // Persist the full set of values (including untouched defaults), not just edited ones.
  saveOverrides(overrides);

  toggleButton?.addEventListener("click", () => {
    panel?.classList.toggle("hidden");
  });

  resetButton?.addEventListener("click", () => {
    for (const key of Object.keys(overrides)) {
      document.documentElement.style.removeProperty(key);
      delete overrides[key];
    }
    saveOverrides(overrides);
    inputs.forEach((input) => {
      const varName = input.dataset.colorVar;
      if (varName) input.value = getCurrentValue(varName);
    });
    window.dispatchEvent(new Event("colors-updated"));
  });

  document.addEventListener("click", (event) => {
    if (!panel || panel.classList.contains("hidden")) return;
    const target = event.target as Node;
    if (panel.contains(target) || toggleButton?.contains(target)) return;
    panel.classList.add("hidden");
  });
</script>
